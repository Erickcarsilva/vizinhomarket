# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Painel do Supabase → Project Settings → API). A chave "anon" é pública por natureza: a segurança fica nas regras do banco.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon

# Contatos de atendimento (opcional). Sem eles, a tela de ajuda mostra uma mensagem neutra.
# VITE_SUPPORT_WHATSAPP=5567999998888
# VITE_SUPPORT_EMAIL=contato@seudominio.com.br
# VITE_SUPPORT_HOURS=Seg–Sáb, 8h às 18h
