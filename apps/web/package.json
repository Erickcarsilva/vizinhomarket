{
  "name": "@vizinhomarket/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode cliente",
    "dev:cliente": "vite --mode cliente",
    "dev:parceiro": "vite --mode parceiro",
    "dev:admin": "vite --mode admin",
    "build": "npm run build:cliente && npm run build:parceiro && npm run build:admin",
    "build:cliente": "vite build --mode cliente --outDir dist/cliente --emptyOutDir",
    "build:parceiro": "vite build --mode parceiro --outDir dist/parceiro --emptyOutDir",
    "build:admin": "vite build --mode admin --outDir dist/admin --emptyOutDir",
    "build:netlify": "vite build --mode ${PRODUTO:-cliente} --outDir dist/site --emptyOutDir",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json"
  },
  "dependencies": {
    "@fontsource/figtree": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.2",
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-query": "^5.84.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.16.4",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.475.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.13.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "baseline-browser-mapping": "^2.8.32",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^15.14.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.2",
    "vite": "^8.2.0"
  }
}
